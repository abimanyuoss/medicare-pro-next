generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionStatus {
  LUNAS
  BELUM_LUNAS
  BATAL
}

enum AccountType {
  ASET
  KEWAJIBAN
  EKUITAS
  PENDAPATAN
  BEBAN
}

enum NormalBalance {
  DEBIT
  KREDIT
}

enum FinancialActivityType {
  MODAL_AWAL
  PEMBELIAN_ASET
  BEBAN_OPERASIONAL
  PRIVE
}

enum JournalSourceType {
  TRANSACTION
  FINANCIAL_ACTIVITY
  MANUAL
}

model Doctor {
  id           String        @id @default(cuid())
  name         String
  specialty    String
  phone        String?
  schedule     String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@map("doctors")
}

model Patient {
  id           String        @id @default(cuid())
  name         String        @unique
  phone        String?
  address      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@map("patients")
}

model Service {
  id           String        @id @default(cuid())
  name         String
  category     String
  price        Decimal       @db.Decimal(12, 2)
  description  String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@map("services")
}

model Medicine {
  id           String                @id @default(cuid())
  name         String
  category     String
  dosage       String
  stock        Int                   @default(0)
  unit         String                @default("tablet")
  price        Decimal               @db.Decimal(12, 2)
  description  String?
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  transactions TransactionMedicine[]

  @@map("medicines")
}

model TransactionMedicine {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  medicineId    String
  medicine      Medicine    @relation(fields: [medicineId], references: [id])
  quantity      Int         @default(1)
  price         Decimal     @db.Decimal(12, 2)

  @@map("transaction_medicines")
}

model Transaction {
  id          String                @id @default(cuid())
  code        String                @unique
  patientName String
  patientId   String?
  patient     Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)
  doctorId    String
  doctor      Doctor                @relation(fields: [doctorId], references: [id])
  serviceId   String
  service     Service               @relation(fields: [serviceId], references: [id])
  complaint   String?
  date        DateTime
  amount      Decimal               @db.Decimal(12, 2)
  status      TransactionStatus     @default(LUNAS)
  notes       String?
  medicines   TransactionMedicine[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([date])
  @@index([status])
  @@map("transactions")
}

model Account {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  type          AccountType
  normalBalance NormalBalance
  statement     String
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  journalLines  JournalLine[]

  @@map("accounts")
}

model JournalEntry {
  id          String            @id @default(cuid())
  code        String            @unique
  date        DateTime
  description String
  sourceType  JournalSourceType @default(MANUAL)
  sourceId    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lines       JournalLine[]

  @@index([date])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)

  @@map("journal_lines")
}

model FinancialActivity {
  id          String                @id @default(cuid())
  code        String                @unique
  type        FinancialActivityType
  date        DateTime
  description String
  amount      Decimal               @db.Decimal(12, 2)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([date])
  @@index([type])
  @@map("financial_activities")
}
